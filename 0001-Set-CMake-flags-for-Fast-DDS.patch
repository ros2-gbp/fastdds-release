From: Scott K Logan <logans@cottsay.net>
Date: Wed, 20 Jan 2021 12:08:26 -0800
Subject: [PATCH 1/2] Set CMake flags for Fast-DDS

Co-authored-by: Shane Loretz <shane.loretz@gmail.com>
---
 rpm/ros-rolling-fastdds.spec | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/rpm/ros-rolling-fastdds.spec b/rpm/ros-rolling-fastdds.spec
index 566b4f3367d7..75beb507e092 100644
--- a/rpm/ros-rolling-fastdds.spec
+++ b/rpm/ros-rolling-fastdds.spec
@@ -81,6 +81,9 @@ giving the user full access to the protocol internals.
 %if !0%{?with_tests}
     -DBUILD_TESTING=OFF \
 %endif
+    -DINSTALL_EXAMPLES=OFF \
+    -DSECURITY=ON \
+    -DAPPEND_PROJECT_NAME_TO_INCLUDEDIR=ON \
 
 %cmake3_build
 

Date: Sat, 12 Feb 2022 10:36:47 -0500
Subject: [PATCH 1/2] Set CMake flags for Fast-RTPS.

Signed-off-by: Scott K Logan <logans@cottsay.net>

Co-authored-by: Scott K Logan <logans@cottsay.net>
---
 rpm/template.spec.em | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/rpm/template.spec.em b/rpm/template.spec.em
index 3464a0bc..91b8a7fd 100644
--- a/rpm/template.spec.em
+++ b/rpm/template.spec.em
@@ -53,6 +53,8 @@ mkdir -p .obj-%{_target_platform} && cd .obj-%{_target_platform}
 %if !0%{?with_tests}
     -DBUILD_TESTING=OFF \
 %endif
+    -DINSTALL_EXAMPLES=OFF \
+    -DSECURITY=ON \
     ..
 
 %make_build
